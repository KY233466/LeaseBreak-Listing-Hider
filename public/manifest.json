{
  "manifest_version": 3,
  "name": "LeaseBreak Listing Hider",
  "version": "1.1.0",
  "description": "Hide, save and see transit commute times for LeaseBreak listings.",
  "action": {
    "default_popup": "index.html",
    "default_title": "LeaseBreak Listing Hider"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "scripting"
  ],
  "host_permissions": [
    "https://www.leasebreak.com/*",
    "https://api.transitous.org/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "transitous_ua",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.leasebreak.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
