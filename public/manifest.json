{
  "manifest_version": 3,
  "name": "LeaseBreak Listing Hider",
  "version": "1.0.0",
  "description": "Hide LeaseBreak listings you're not interested in from search results.",
  "action": {
    "default_popup": "index.html",
    "default_title": "LeaseBreak Listing Hider"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.leasebreak.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.leasebreak.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
